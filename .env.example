# PostgreSQL database name
POSTGRES_DB=asianmarkets

# PostgreSQL user
POSTGRES_USER=admin

# PostgreSQL password -- change this before any deployment
POSTGRES_PASSWORD=change_me

# Full PostgreSQL connection string; docker-compose.yml builds this for node-api/python-api/celery-worker/flower from the three vars above, but server/utils/db.js and analytics/app/db.py also read it directly
DATABASE_URL=postgresql://admin:change_me@localhost:5432/asianmarkets

# Redis connection string (Celery broker/result backend + forecast cache + pub/sub), read by the Python analytics service and Celery worker
REDIS_URL=redis://localhost:6379/0

# Twelve Data API key, used as a fallback price source when Yahoo Finance fails -- optional; get a free-tier key at https://twelvedata.com/
TWELVE_DATA_KEY=

# Node.js gateway port
PORT=4000

# Node.js runtime mode; docker-compose.yml sets this directly to "production" for the containerized node-api service, so this only matters when running server/ outside Docker
NODE_ENV=development

# Base URL of the Python analytics service, used by server/utils/deltaFetch.js and scripts/collectFundamentals.js when run outside Docker (defaults to http://localhost:8000 if unset)
PYTHON_API_URL=http://localhost:8000

# Base URL of the Node.js gateway, used by the Python analytics service's feature builder (defaults to http://node-api:4000 if unset; only relevant inside Docker's network)
NODE_API_URL=http://node-api:4000
